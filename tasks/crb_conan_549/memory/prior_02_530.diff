diff --git a/conan/tools/scm/git.py b/conan/tools/scm/git.py
index 7fa89f54d08..d829ebe8590 100644
--- a/conan/tools/scm/git.py
+++ b/conan/tools/scm/git.py
@@ -112,6 +112,19 @@ def commit_in_remote(self, commit, remote="origin"):
         except Exception as e:
             raise ConanException("Unable to check remote commit in '%s': %s" % (self.folder, str(e)))
 
+        try:
+            refs = self.run(f"ls-remote {remote}")
+            if commit in refs:
+                return True
+        except (Exception,):
+            pass
+
+        try:
+            self.run(f"cat-file -e {commit}^{{commit}}")
+            return False
+        except (Exception,):
+            pass
+
         try:
             # This will raise if commit not present.
             self.run(f"fetch {remote} --dry-run {commit}")
